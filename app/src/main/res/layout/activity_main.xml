<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kinect Caseiro"
        android:textColor="@color/text_light"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="64dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Serviço Desativado"
        android:textColor="#AAAAAA"
        android:textSize="16sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <SeekBar
        android:id="@+id/seekBarSensitivity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="150"
        android:layout_marginTop="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/rgGameMode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    
    <!-- Seletor de Modo de Jogo -->
    <RadioGroup
        android:id="@+id/rgGameMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioButton
            android:id="@+id/rbModeClick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modo Clique"
            android:textColor="@color/text_light"
            android:checked="true"
            android:buttonTint="@color/btn_on"
            android:layout_marginEnd="16dp"/>

        <RadioButton
            android:id="@+id/rbModeSwipe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modo Swipe"
            android:textColor="@color/text_light"
            android:buttonTint="@color/btn_on"/>
    </RadioGroup>

    <!-- ToggleButton Gigante -->
    <ToggleButton
        android:id="@+id/btnToggleService"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/btn_toggle_selector"
        android:textColor="@color/text_light"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textOff="OFF"
        android:textOn="ON"
        android:elevation="8dp"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
