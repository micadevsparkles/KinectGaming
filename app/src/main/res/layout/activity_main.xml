<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kinect Caseiro"
        android:textColor="@color/text_light"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Serviço Desativado"
        android:textColor="#AAAAAA"
        android:textSize="16sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Área das Colunas de Configuração -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        app:layout_constraintBottom_toTopOf="@id/btnToggleService"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Cabeçalho das Colunas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Movimento do Corpo"
                    android:textColor="@color/text_light"
                    android:textStyle="bold"
                    android:textAlignment="center"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Toque na Tela"
                    android:textColor="@color/text_light"
                    android:textStyle="bold"
                    android:textAlignment="center"/>
            </LinearLayout>

            <!-- Slot 1 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                <Spinner android:id="@+id/spinPhys1" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="#DDDDDD" android:layout_marginEnd="4dp"/>
                <Spinner android:id="@+id/spinTouch1" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="#DDDDDD" android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- Slot 2 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                <Spinner android:id="@+id/spinPhys2" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="#DDDDDD" android:layout_marginEnd="4dp"/>
                <Spinner android:id="@+id/spinTouch2" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="#DDDDDD" android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- Slot 3 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                <Spinner android:id="@+id/spinPhys3" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="#DDDDDD" android:layout_marginEnd="4dp"/>
                <Spinner android:id="@+id/spinTouch3" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="#DDDDDD" android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- Slot 4 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                <Spinner android:id="@+id/spinPhys4" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="#DDDDDD" android:layout_marginEnd="4dp"/>
                <Spinner android:id="@+id/spinTouch4" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="#DDDDDD" android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- Slot 5 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                <Spinner android:id="@+id/spinPhys5" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="#DDDDDD" android:layout_marginEnd="4dp"/>
                <Spinner android:id="@+id/spinTouch5" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="#DDDDDD" android:layout_marginStart="4dp"/>
            </LinearLayout>
            
            <!-- Slot 6 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                <Spinner android:id="@+id/spinPhys6" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="#DDDDDD" android:layout_marginEnd="4dp"/>
                <Spinner android:id="@+id/spinTouch6" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="#DDDDDD" android:layout_marginStart="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ToggleButton Menor na Base -->
    <ToggleButton
        android:id="@+id/btnToggleService"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/btn_toggle_selector"
        android:textColor="@color/text_light"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textOff="OFF"
        android:textOn="ON"
        android:elevation="8dp"
        android:stateListAnimator="@null"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
