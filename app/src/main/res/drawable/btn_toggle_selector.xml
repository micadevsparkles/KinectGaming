<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado ON (Pressionado/Afundado) -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/btn_on_pressed" />
            <stroke android:width="2dp" android:color="@color/btn_on" />
        </shape>
    </item>
    <!-- Estado OFF (Solto/Para cima) -->
    <item android:state_checked="false">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/btn_off" />
            <padding android:bottom="8dp" /> <!-- Cria a ilusão 3D de botão alto -->
        </shape>
    </item>
</selector>
